# Postgres for shared demo state. Without it, Iris keeps state in server memory until restart.
DATABASE_URL=postgres://postgres@localhost:5433/iris_local
# Set to "require" for hosted Postgres that needs TLS (Replit, Neon).
DATABASE_SSL=

# Venues are in Chicago, Atlanta and Dallas; keep the server's "today" on Central time.
TZ=America/Chicago

# Signs session cookies. Required in production; any long random string.
IRIS_SESSION_SECRET=
# Optional passcode on the sign-in page for hosted demos.
IRIS_DEMO_PASSCODE=
# Tenant every session uses. Change it to keep a rehearsal separate from the live demo.
IRIS_TENANT=demo
